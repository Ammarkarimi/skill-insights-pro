# Copy to backend/.env for local development, or set these in your host's dashboard.
ENVIRONMENT=development            # development | production
APP_URL=http://localhost:8080      # public URL; must be https:// in production
JWT_SECRET=                        # REQUIRED in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./skillsphere.db   # production: postgresql://user:pass@host:5432/db

# OpenAI (required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini            # used for resume analysis, assessments, interviews, job match
OPENAI_MODEL_FAST=gpt-5-mini       # used for chat, skill extraction, interview questions
OPENAI_REASONING_EFFORT=low        # minimal|low|medium|high; set empty for non-reasoning models (e.g. gpt-4.1)

# Billing (Stripe Checkout). Leave empty to disable purchases.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
FREE_SIGNUP_CREDITS=10
# Optional overrides (JSON):
# CREDIT_PACKS=[{"id":"starter","name":"Starter","credits":40,"price_cents":399}]
# ACTION_COSTS={"resume_analysis":3,"chat_message":1}

# Optional: rupee payments in India (UPI, cards, netbanking) via Razorpay.
# Webhook: {APP_URL}/api/billing/razorpay/webhook with events payment.captured and order.paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# INR_CREDIT_PACKS=[{"id":"inr-pro","name":"Pro","credits":120,"price_cents":24900}]  # paise

# Email for password reset and opt-in reminders. Any SMTP provider (SES, Postmark, SendGrid, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=                          # e.g. SkillSphere <hello@yourdomain.com>
SMTP_SECURITY=starttls              # starttls | ssl | none
# Call POST {APP_URL}/api/internal/cron/reminders hourly with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional: live job-market data from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: GitHub. An OAuth app (callback: {APP_URL}/api/github/callback) lets users verify that
# they own the repos they submit for review. GITHUB_TOKEN raises the API rate limit for repo reads;
# use a fine-grained token with no extra permissions.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Leave empty: the recommended deployment serves the frontend from the API (same origin).
# Only set this if you host the frontend on a different origin than the API
CORS_ORIGINS=
